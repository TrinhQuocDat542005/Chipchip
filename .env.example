# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
HF_TOKEN=""
GEMINI_TEXT_MODEL="gemini-3.5-flash-lite"
IMAGE_PROVIDER="placeholder"
VIDEO_PROVIDER="local-motion"
IMAGEN_MODEL="imagen-3.0-generate-002"

# Local VieNeu is the recommended Vietnamese TTS provider. Use "mock" until
# the Python service is installed and running.
TTS_PROVIDER="mock"
VIENEU_SERVICE_URL="http://127.0.0.1:8787"
VIENEU_MODEL="pnnbao-ump/VieNeu-TTS-v2"
VIENEU_CODEC_MODEL="neuphonic/distill-neucodec"
VIENEU_BACKBONE_DEVICE="cpu"
VIENEU_CODEC_DEVICE="cpu"

# Generated media is written here and served by Express under /media.
ASSET_ROOT="./storage"
MAX_UPLOAD_MB="100"
MONTHLY_BUDGET_USD="20"
ASR_PYTHON_PATH="./.venv-asr/Scripts/python.exe"
WHISPER_MODEL="small"
MAX_DUB_UPLOAD_MB="500"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
